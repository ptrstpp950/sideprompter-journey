<Project Sdk="Microsoft.NET.Sdk">
  <!-- Common properties -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>false</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Recommended Avalonia trimming settings for Native AOT -->
    <TrimMode>link</TrimMode>
  </PropertyGroup>

  <!-- macOS specific properties -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFramework>net9.0-macos</TargetFramework>
    <ApplicationId>com.sideprompter.app</ApplicationId>
    <CFBundleIdentifier>com.sideprompter.app</CFBundleIdentifier>
    <CFBundleName>AvaloniaApp</CFBundleName>
    <CFBundleDisplayName>Avalonia App</CFBundleDisplayName>
    <CFBundleVersion>1.0</CFBundleVersion>
    <CFBundleShortVersionString>1.0</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <NSPrincipalClass>NSApplication</NSPrincipalClass>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <!-- Enable Universal Binary support -->
    <RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Enable entitlements -->
    <!-- For Debug builds, disable code signing for testing -->
    <EnableCodeSigning Condition="'$(Configuration)' == 'Release'">true</EnableCodeSigning>
    <EnablePackageSigning Condition="'$(Configuration)' == 'Release'">false</EnablePackageSigning>
    <EnableCodeSigning Condition="'$(Configuration)' != 'Release'">false</EnableCodeSigning>
    <EnablePackageSigning Condition="'$(Configuration)' != 'Release'">false</EnablePackageSigning>
    <PackageSigningKey>Apple Development</PackageSigningKey>
    <CodeSigningKey>Apple Development: ptrstpp950@gmail.com (3MF59T34B3)</CodeSigningKey>
    <UseHardenedRuntime>false</UseHardenedRuntime>
    <CodesignTimestamp>false</CodesignTimestamp>
    <PackageEntitlementsFile>AvaloniaApp.entitlements</PackageEntitlementsFile>
    <CodesignEntitlement>AvaloniaApp.entitlements</CodesignEntitlement>
  </PropertyGroup>

  <!-- Windows specific properties -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve Avalonia types for reflection -->
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.4" />
    <PackageReference Include="HeroIcons.Avalonia" Version="1.0.2" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.4">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="HotKeyManager.Binding" Version="3.0.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.8.0-preview.1.25412.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.4" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="Info.plist">
      <Link>Info.plist</Link>
    </None>
    <None Include="AvaloniaApp.entitlements">
      <Link>AvaloniaApp.entitlements</Link>
    </None>
  </ItemGroup>

  <!-- Copy Whisper.NET native libraries to the correct location for macOS -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/macos-x64/libwhisper.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/macos-x64/libggml-whisper.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/macos-x64/libggml-base-whisper.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/macos-x64/libggml-cpu-whisper.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/macos-x64/libggml-blas-whisper.dylib" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- For macOS app bundles, copy resources to Resources folder -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- Use BundleResource for macOS app bundle -->
    <BundleResource Include="libs/audioteejs/bin/audiotee">
      <LogicalName>libs/audioteejs/bin/audiotee</LogicalName>
    </BundleResource>
    <!-- Add ggml-metal.metal as a BundleResource to fix code signing issue -->
    <BundleResource Include="$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/ggml-metal.metal">
      <LogicalName>ggml-metal.metal</LogicalName>
    </BundleResource>
    <!-- Add .env as a BundleResource -->
    <BundleResource Include=".env">
      <LogicalName>.env</LogicalName>
    </BundleResource>
  </ItemGroup>

  <!-- For non-bundle output, copy files to output directory -->
  <ItemGroup>
    <None Include="libs/audioteejs/bin/audiotee" CopyToOutputDirectory="PreserveNewest" TargetPath="libs/audioteejs/bin/audiotee" Visible="false" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
    <None Include=".env" CopyToOutputDirectory="Always" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <Target Name="BuildActiveWindowTextGetter" Condition="$([MSBuild]::IsOSPlatform('OSX'))" BeforeTargets="Build" Inputs="libs/activeWindowTextGetter/Sources/**/*.swift" Outputs="libs/activeWindowTextGetter/.build/release/activeWindowTextGetter">
    <Exec Command="cd libs/activeWindowTextGetter &amp;&amp; swift build --configuration release" />
  </Target>

  <!-- Remove ggml-metal.metal from root directory of app bundle to fix code signing -->
  <Target Name="RemoveMetalFileFromRoot" AfterTargets="_CompileToNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Delete Files="$(OutputPath)$(AssemblyName).app/ggml-metal.metal" />
  </Target>

</Project>
