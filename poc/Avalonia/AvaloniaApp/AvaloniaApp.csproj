<Project Sdk="Microsoft.NET.Sdk">
  <!-- Common properties -->
  <PropertyGroup>
    <Version>0.1.11</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>false</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Recommended Avalonia trimming settings for Native AOT -->
    <TrimMode Condition="'$(Configuration)' == 'Release'">link</TrimMode>
    <WhisperNetRuntimeVersion>1.8.1</WhisperNetRuntimeVersion>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AssemblyName>SidePrompter</AssemblyName>
    <!-- Velopack metadata -->
    <VeloPackId>com.sideprompter.app</VeloPackId>
    <VeloPackTitle>SidePrompter</VeloPackTitle>
    <VeloPackAuthors>SidePrompter.com</VeloPackAuthors>
    <VeloPackPublisherName>SidePrompter.com</VeloPackPublisherName>
    <VeloPackIcon>Assets/icon.ico</VeloPackIcon>
    <!-- Example: set a channel / feed later via env or props -->
    <VeloPackChannel Condition=" '$(VeloPackChannel)' == '' ">stable</VeloPackChannel>
  </PropertyGroup>


  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/**"/>
  </ItemGroup>

  
  <!-- Windows specific properties -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <TargetFramework>net9.0-macos</TargetFramework>
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve Avalonia types for reflection -->
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="NAudio.Wasapi" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.5" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.5">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HeroIcons.Avalonia" Version="1.0.4" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="HotAvalonia" Version="3.0.0" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotKeyManager.Binding" Version="3.0.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.8.0-preview.1.25412.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.4" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Deepgram" Version="6.6.0" />
    <!-- Velopack package (using latest available prerelease; adjust as needed) -->
    <PackageReference Include="Velopack" Version="0.0.1369-g1d5c984" />
  </ItemGroup>
  
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="Info.plist">
      <Link>Info.plist</Link>
    </None>
    <None Include="SidePrompter.entitlements">
      <Link>SidePrompter.entitlements</Link>
    </None>
  </ItemGroup>

  <!-- Copy Whisper.NET native libraries to the correct location for macOS -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(NuGetPackageRoot)whisper.net.runtime/$(WhisperNetRuntimeVersion)/runtimes/$(RuntimeIdentifier)/native/*.*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- For macOS app bundles, copy resources to Resources folder -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <!-- Use BundleResource for macOS app bundle -->
    <BundleResource Include="libs/audiotee/bin/audiotee">
      <LogicalName>libs/audiotee/bin/audiotee</LogicalName>
    </BundleResource>
    <!-- App icon: ensure the .icns is bundled into the .app/Contents/Resources -->
    <BundleResource Include="Assets/icon.icns">
      <LogicalName>icon.icns</LogicalName>
    </BundleResource>
    <!-- Add ggml-metal.metal as a BundleResource to fix code signing issue -->
    <BundleResource Include="$(NuGetPackageRoot)whisper.net.runtime/$(WhisperNetRuntimeVersion)/build/ggml-metal.metal">
      <LogicalName>ggml-metal.metal</LogicalName>
    </BundleResource>
    <!-- Add .env as a BundleResource -->
    <BundleResource Include=".env">
      <LogicalName>.env</LogicalName>
    </BundleResource>
    <!-- Add Swift-built helper binaries into the app Resources -->
    <BundleResource Include="libs/activeWindowTextGetter/.build/apple/Products/Release/activeWindowTextGetter">
      <LogicalName>libs/activeWindowTextGetter/activeWindowTextGetter</LogicalName>
    </BundleResource>
    <BundleResource Include="libs/hotkeyListener/.build/apple/Products/Release/hotkeyListener">
      <LogicalName>libs/hotkeyListener/hotkeyListener</LogicalName>
    </BundleResource>
  </ItemGroup>

  <!-- For non-bundle output, copy files to output directory -->
  <ItemGroup>
    <!--None Include="libs/audiotee/bin/audiotee" CopyToOutputDirectory="PreserveNewest" TargetPath="libs/audiotee/bin/audiotee" Visible="false" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" /-->
    <None Include=".env" CopyToOutputDirectory="Always" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <!-- Copy Swift-built helper binaries into the Debug output dir on macOS for local debugging -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(Configuration)' == 'Debug'">
    <Content Include="libs/activeWindowTextGetter/.build/apple/Products/Release/activeWindowTextGetter">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libs/activeWindowTextGetter/activeWindowTextGetter</TargetPath>
    </Content>
    <Content Include="libs/hotkeyListener/.build/apple/Products/Release/hotkeyListener">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libs/hotkeyListener/hotkeyListener</TargetPath>
    </Content>
    <Content Include="libs/audiotee/bin/audiotee">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libs/audiotee/bin/audiotee</TargetPath>
    </Content>
  </ItemGroup>

  <Target Name="BuildActiveWindowTextGetter" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(Configuration)' == 'Release'" BeforeTargets="Build" Inputs="libs/activeWindowTextGetter/Sources/**/*.swift" Outputs="libs/activeWindowTextGetter/.build/apple/Products/Release/activeWindowTextGetter">
    <Exec Command="cd libs/activeWindowTextGetter &amp;&amp; swift build --configuration release --arch arm64 --arch x86_64" />
  </Target>
  <Target Name="BuildHotKeyListener" Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(Configuration)' == 'Release'" BeforeTargets="Build" Inputs="libs/hotkeyListener/Sources/**/*.swift" Outputs="libs/hotkeyListener/.build/apple/Products/Release/hotkeyListener">
    <Exec Command="cd libs/hotkeyListener &amp;&amp; swift build --configuration release --arch arm64 --arch x86_64" />
  </Target>
    
  <!-- Move whisper native libs from MonoBundle/runtimes/macos-x64 -> MonoBundle for osx-x64 builds -->
  <Target Name="FlattenMonoBundleWhisperRuntimes" AfterTargets="_CompileToNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <RuntimeFolder Condition="'$(RuntimeIdentifier)' == 'osx-x64'">macos-x64</RuntimeFolder>
      <RuntimeFolder Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">macos-arm64</RuntimeFolder>
    </PropertyGroup>
    <ItemGroup>
      <_WhisperNativeLibs Include="$(OutputPath)$(AssemblyName).app/Contents/MonoBundle/runtimes/$(RuntimeFolder)/*.*" />
      <_FilesToDelete Include="$(OutputPath)$(AssemblyName).app/Contents/MonoBundle/runtimes/**/*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(_WhisperNativeLibs)" DestinationFolder="$(OutputPath)$(AssemblyName).app/Contents/MonoBundle/" SkipUnchangedFiles="true" />
    <!--Delete Files="@(_FilesToDelete)" /-->
  </Target>
  

  <!-- Remove ggml-metal.metal from root directory of app bundle to fix code signing -->
  <Target Name="RemoveMetalFileFromRoot" AfterTargets="_CompileToNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Delete Files="$(OutputPath)$(AssemblyName).app/ggml-metal.metal" />
  </Target>

  <!-- Ensure helper binaries inside the .app bundle are executable -->
  <Target Name="SetBinariesExecutable" AfterTargets="_CompileToNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="chmod +x &quot;$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/activeWindowTextGetter/activeWindowTextGetter&quot;" Condition="Exists('$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/activeWindowTextGetter/activeWindowTextGetter')" />
    <Exec Command="chmod +x &quot;$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/hotkeyListener/hotkeyListener&quot;" Condition="Exists('$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/hotkeyListener/hotkeyListener')" />
    <Exec Command="chmod +x &quot;$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/audiotee/bin/audiotee&quot;" Condition="Exists('$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/audiotee/bin/audiotee')" />
  </Target>

  <!-- Ensure Swift helper binaries inside the .app bundle are executable -->
  <!--Target Name="SetSwiftBinariesExecutable" AfterTargets="_CompileToNative" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="/bin/bash -lc 'if [ -f \"$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/activeWindowTextGetter/activeWindowTextGetter\" ]; then chmod +x \"$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/activeWindowTextGetter/activeWindowTextGetter\"; fi'" />
    <Exec Command="/bin/bash -lc 'if [ -f \"$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/hotkeyListener/hotkeyListener\" ]; then chmod +x \"$(OutputPath)$(AssemblyName).app/Contents/Resources/libs/hotkeyListener/hotkeyListener\"; fi'" />
  </Target-->

</Project>
