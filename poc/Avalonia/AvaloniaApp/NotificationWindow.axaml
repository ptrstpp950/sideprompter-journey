<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApp.NotificationWindow"
        Width="320"
        CanResize="False"
        Topmost="True"
        SystemDecorations="None"
        ShowInTaskbar="False"
        TransparencyLevelHint="None"
        Background="#00000000"
        SizeToContent="WidthAndHeight"
        Padding="0"
        Opacity="0"
        FontSize="13"
        WindowStartupLocation="Manual"
        Title="Notification">
    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CircularEaseOut" />
        </Transitions>
    </Window.Transitions>
    <Border Background="#2d2d2d" CornerRadius="4" BorderBrush="#444" BorderThickness="1" Padding="12">
        <Grid ColumnDefinitions="* Auto" RowDefinitions="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#f1f5f9" MaxWidth="260" Grid.Column="0"/>
            <Button Grid.Column="1" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Classes="NotificationCloseButton" Click="CloseButton_OnClick" Padding="4" Margin="8,0,0,0" />
        </Grid>
    </Border>
</Window>