<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AvaloniaApp"
        x:Class="AvaloniaApp.SetupWizard"
        Width="900" Height="600"
        Title="Settings"
        CanResize="True"
        x:CompileBindings="True"
        mc:Ignorable="d"
        x:DataType="vm:SetupWizardViewModel">
  <d:Design.DataContext>
    <vm:SetupWizardViewModel />
  </d:Design.DataContext>
  <Grid ColumnDefinitions="220, *" RowDefinitions="* Auto" Margin="0">
    <!-- Navigation -->
    <Border Background="{DynamicResource ThemeControlLowBrush}" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="0,0,1,0">
      <StackPanel>
        <TextBlock Text="SidePrompter" FontSize="18" FontWeight="Bold" Margin="16,16,16,8" />
  <ListBox ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage}"
                 BorderThickness="0"
                 x:Name="NavList"
                 Margin="0,4,0,8">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="12 8" />
            </Style>
            <Style Selector="ListBoxItem:selected">
              <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Icon}" FontSize="16" />
                <TextBlock Text="{Binding Title}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" 
                   FontSize="12" 
                   Foreground="{DynamicResource ThemeForegroundLowBrush}" 
                   Margin="16,0,16,16" 
                   HorizontalAlignment="Left" />
        <!-- Update button: visible when UpdateIsReady is true -->
        <Button Margin="16,0,16,16"
                FontSize="12"
                Content="Restart &amp; Update"
                Command="{Binding UpdateNowCommand}"
                IsVisible="{Binding UpdateIsReady}" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <Border Grid.Column="1" Padding="24" Background="{DynamicResource ThemeBackgroundBrush}">
      <Grid>
        <ContentControl Content="{Binding SelectedPage.View}" />
        <Border Background="{DynamicResource ThemeControlMidBrush}" IsVisible="{Binding IsBusy}" CornerRadius="4">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="24" Background="{DynamicResource ThemeControlLowBrush}" CornerRadius="6">
            <StackPanel Spacing="14">
              <TextBlock Text="Downloading model" FontSize="16" FontWeight="Bold" />
              <TextBlock Text="{Binding BusyMessage}" TextWrapping="Wrap" FontSize="12"/>
              <ProgressBar IsIndeterminate="{Binding IsBusyIndeterminate}" Minimum="0" Maximum="100" Value="{Binding BusyProgress}" Height="14" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelDownloadCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Border>

    <!-- Buttons -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource ThemeControlLowBrush}" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="0,1,0,0" Padding="12 10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" Margin="0,0,12,0" VerticalAlignment="Center" />
        <Button Content="Reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsSettingsMode}" />
        <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding IsNotBusy}" />
        <Button Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}" IsDefault="True" IsEnabled="{Binding IsNotBusy}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>