<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
        x:Class="AvaloniaApp.ChatHistoryWindow"
        x:DataType="viewModel:ChatViewModel"
        x:CompileBindings="True"
        Width="520" Height="400"
        Title="Chat History"
        CanResize="True"
        mc:Ignorable="d">
  <Window.Resources>
    <viewModel:AuthorToBackgroundBrushConverter x:Key="BgConv" />
    <viewModel:AuthorToForegroundBrushConverter x:Key="FgConv" />
    <viewModel:AuthorToAlignmentConverter x:Key="AlignConv" />
  </Window.Resources>
  <Grid Margin="8">
    <TabControl>
      <TabItem Header="Chat">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModel:ChatMessage">
                <Border Margin="4,6" Padding="10" CornerRadius="8"
                        Background="{Binding Author, Converter={StaticResource BgConv}}"
                        HorizontalAlignment="{Binding Author, Converter={StaticResource AlignConv}}">
                  <TextBlock TextWrapping="Wrap"
                             Foreground="{Binding Author, Converter={StaticResource FgConv}}"
                             Text="{Binding Text}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Logs">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding LogMessages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModel:ChatMessage">
                <Border Margin="4,4" Padding="6" Background="#222" CornerRadius="6">
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9ca3af" Text="{Binding Text}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>