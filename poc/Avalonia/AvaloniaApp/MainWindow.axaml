<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
    xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
    x:Class="AvaloniaApp.MainWindow"
    x:DataType="viewModel:ChatViewModel"
    x:CompileBindings="True"
    Width="640" Height="90"
    CanResize="True"
    Topmost="True"
    WindowStartupLocation="Manual"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="28"
    Padding="0"
    mc:Ignorable="d"
    Title="SidePrompter">
    <!--
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    Background="Transparent"
    Opacity="0.7"
    -->

    <Window.Resources>
        <viewModel:BooleanToTextConverter x:Key="BoolToText" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,6">
        <!-- Controls row -->
        <DockPanel Grid.Row="0" Margin="12,4,12,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ToggleButton"
                              Checked="ToggleButton_OnChecked"
                              Unchecked="ToggleButton_OnUnchecked">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon x:Name="StartIcon" IsVisible="True" Type="PlayCircle" Foreground="#22c55e" Kind="Solid" />
                        <heroIcons:HeroIcon x:Name="StopIcon" IsVisible="False" Type="StopCircle" Foreground="#c52230" Kind="Solid" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ResetButton" Classes="IconButton" Width="40" Height="36" Click="ResetButton_OnClick" ToolTip.Tip="Reset Chat">
                    <heroIcons:HeroIcon Type="ArrowPath" Foreground="#f59e0b" Kind="Solid" />
                </Button>
                <Border Classes="HeaderChip" ToolTip.Tip="Elapsed time">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="Clock" Foreground="#9ca3af" Width="16" Height="16" Kind="Solid" />
                        <TextBlock x:Name="ElapsedTimeText" Text="00:00" FontWeight="SemiBold" Foreground="#e5e7eb" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Classes="IconButton" Width="40" Height="36" Click="SettingsButton_OnClick" ToolTip.Tip="Settings">
                    <heroIcons:HeroIcon Type="Cog6Tooth" Foreground="#9ca3af" Kind="Solid" />
                </Button>
                <Button x:Name="HistoryButton" Classes="IconButton" Width="40" Height="36" Click="HistoryButton_OnClick" ToolTip.Tip="History">
                    <heroIcons:HeroIcon Type="ChatBubbleLeftRight" Foreground="#60a5fa" Kind="Solid" />
                </Button>
                <ToggleButton x:Name="PrivacyToggleButton" IsChecked="True" Checked="PrivacyToggleButton_OnChecked" Unchecked="PrivacyToggleButton_OnUnchecked" ToolTip.Tip="Toggle Window Privacy">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon x:Name="ProtectedIcon" IsVisible="True" Type="ShieldCheck" Foreground="#22c55e" Kind="Solid" />
                        <heroIcons:HeroIcon x:Name="UnprotectedIcon" IsVisible="False" Type="ShieldExclamation" Foreground="#c52230" Kind="Solid" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="AddContextButton" Classes="HeaderChip" Height="36" ToolTip.Tip="Add Context" Click="AddContextButton_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="PlusCircle" Foreground="#10b981" Width="16" Height="16" Kind="Solid" />
                        <TextBlock Text="Add Ctx (Alt+?)" Foreground="#cbd5e1" FontSize="11"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
        <!-- Prompt selection row -->
        <DockPanel Grid.Row="1" x:Name="BeforeStartRow"  Margin="12,4,12,0" LastChildFill="False" IsVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="AskAiButton" Classes="HeaderChip" Height="36" ToolTip.Tip="Ask AI (Win+?)" Click="AskAiButton_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="4" MaxWidth="50" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="QuestionMarkCircle" Foreground="#a855f7" Width="16" Height="16" Kind="Solid" IsVisible="{Binding !IsAsking}" />
                        <ProgressBar IsVisible="{Binding IsAsking}" MaxWidth="16" Height="6" IsIndeterminate="True" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IsAsking, Converter={StaticResource BoolToText}, ConverterParameter='Asking...|Ask AI'}" Foreground="#cbd5e1" FontSize="11" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Prompt:" VerticalAlignment="Center"/>
                <ComboBox x:Name="PromptComboBox" MinHeight="32" ItemsSource="{Binding Settings.Prompts}" DisplayMemberBinding="{Binding Title}" SelectedItem="{Binding SelectedPrompt}"/>
                <TextBlock Text="Language:" VerticalAlignment="Center"/>
                <ComboBox x:Name="LanguageComboBox" Width="65" MinHeight="32" IsVisible="True"/>
            </StackPanel>
        </DockPanel>
        <TextBox Grid.Row="2" x:Name="AiAssistantResponseTextBox" Text="Press WIN+? to get your first tip"
                 Margin="12,0,12,4" IsReadOnly="True"
                 TextWrapping="Wrap" Height="120" MaxHeight="120"
                 IsVisible="False"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" />
    <!-- Placeholder (no logs displayed) -->
    </Grid>
</Window>

