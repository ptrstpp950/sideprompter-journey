<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
    xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
    x:Class="AvaloniaApp.MainWindow"
    x:DataType="viewModel:ChatViewModel"
    Width="640" Height="120"
    CanResize="True"
    WindowStartupLocation="Manual"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="28"
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    Background="#CC1E1E1E"
    Padding="0"
    mc:Ignorable="d"
    Title="SidePrompter">
    
    <Grid RowDefinitions="Auto,Auto" Margin="0,6,0,6">
        <!-- Controls row -->
        <DockPanel Grid.Row="1" Margin="12,4,12,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ToggleButton"
                              Checked="ToggleButton_OnChecked"
                              Unchecked="ToggleButton_OnUnchecked">
                    <heroIcons:HeroIcon x:Name="StartStopIcon" Type="PlayCircle" Foreground="#22c55e" Kind="Solid" />
                </ToggleButton>
                <Button x:Name="SettingsButton" Classes="IconButton" Width="40" Height="36" Click="SettingsButton_OnClick" ToolTip.Tip="Settings">
                    <heroIcons:HeroIcon Type="Cog6Tooth" Foreground="#9ca3af" Kind="Solid" />
                </Button>
                <Border Classes="HeaderChip" ToolTip.Tip="Elapsed time">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="Clock" Foreground="#9ca3af" Width="16" Height="16" Kind="Solid" />
                        <TextBlock x:Name="ElapsedTimeText" Text="00:00" FontWeight="SemiBold" Foreground="#e5e7eb"/>
                    </StackPanel>
                </Border>
                <Border Classes="HeaderChip" ToolTip.Tip="Ask AI">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="QuestionMarkCircle" Foreground="#a855f7" Width="16" Height="16" Kind="Solid" />
                        <TextBlock Text="Ask AI (Win+? / Cmd+?)" Foreground="#cbd5e1" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Classes="HeaderChip" ToolTip.Tip="Add Context">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="PlusCircle" Foreground="#10b981" Width="16" Height="16" Kind="Solid" />
                        <TextBlock Text="Add Ctx (Alt+? / Opt+?)" Foreground="#cbd5e1" FontSize="11"/>
                    </StackPanel>
                </Border>
                <!-- Hidden language picker (future use) -->
        <ComboBox x:Name="LanguageComboBox" Width="120" MinHeight="32" IsVisible="False"/>
            </StackPanel>
        </DockPanel>
    <!-- Placeholder (no logs displayed) -->
    </Grid>
</Window>
