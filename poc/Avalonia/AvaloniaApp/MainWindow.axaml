<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AvaloniaApp"
        xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="AvaloniaApp.MainWindow"
        x:DataType="viewModel:ChatViewModel"
        Title="AvaloniaApp">
    <Window.Resources>
        <viewModel:AuthorToAlignmentConverter x:Key="AuthorToAlignmentConverter"/>
        <viewModel:AuthorToBackgroundBrushConverter x:Key="AuthorToBackgroundBrushConverter"/>
        <viewModel:AuthorToForegroundBrushConverter x:Key="AuthorToForegroundBrushConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <TabControl>
            <TabItem Header="Transcription">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="5" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Audio Source:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="SystemAudioCheckBox" Content="System Audio" IsChecked="True" Margin="10,0,0,0"/>
                        <CheckBox x:Name="MicrophoneCheckBox" Content="Microphone" IsChecked="False" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Select Language:"/>
                    <ComboBox x:Name="LanguageComboBox" Width="200"/>
                    <ToggleButton x:Name="ToggleButton" Content="Start Transcription" Width="200"
                                  Checked="ToggleButton_OnChecked" Unchecked="ToggleButton_OnUnchecked"/>
                    <Button x:Name="TestChatButton" Content="Test Chat" Click="TestChatButton_OnClick" />
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModel:ChatMessage">
                                    <Border Margin="5"
                                            CornerRadius="10"
                                            Padding="10"
                                            HorizontalAlignment="{Binding Author, Converter={StaticResource AuthorToAlignmentConverter}}"
                                            Background="{Binding Author, Converter={StaticResource AuthorToBackgroundBrushConverter}}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   Foreground="{Binding Author, Converter={StaticResource AuthorToForegroundBrushConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>
            <TabItem Header="Window Text">
                <StackPanel Spacing="12">
                    <TextBlock Text="Extract text from active window:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActiveWindowTitleBlock" Text="No window selected" Grid.Column="0"/>
                        <Button x:Name="RefreshWindowButton" Content="Refresh" Grid.Column="1"
                                Click="RefreshWindowButton_OnClick" Width="100"/>
                    </Grid>
                    <Button x:Name="GetWindowTextButton" Content="Get Window Text" Width="200"
                            Click="GetWindowTextButton_OnClick"/>
                    <Button x:Name="GetWindowTextCliButton" Content="Get Window Text (CLI)" Width="200"
                            Click="GetWindowTextCliButton_OnClick"/>
                    <CheckBox x:Name="PrivacyModeCheckBox" Content="Privacy Mode (Hide this window from capture)"
                              Checked="PrivacyMode_OnToggled" Unchecked="PrivacyMode_OnToggled"/>
                    <TextBlock Text="Register ALT+W to extract window text:"/>
                    <Button x:Name="RegisterHotkeyButton" Content="Register Hotkey" Width="200"
                            Click="RegisterHotkeyButton_OnClick"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Logs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModel:ChatMessage">
                                <Border Margin="5"
                                        CornerRadius="10"
                                        Padding="10"
                                        HorizontalAlignment="Left"
                                        Background="LightGray">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
