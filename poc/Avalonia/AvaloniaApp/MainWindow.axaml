<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
    xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
    x:Class="AvaloniaApp.MainWindow"
    x:DataType="viewModel:ChatViewModel"
    x:CompileBindings="True"
    Width="380" Height="190"
    CanResize="True"
    Topmost="True"
    WindowStartupLocation="Manual"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="28"
    Padding="0"
    mc:Ignorable="d"
    Title="SidePrompter">
    <!--
    TransparencyLevelHint="AcrylicBlur,Blur,Transparent"
    Background="Transparent"
    Opacity="0.7"
    -->



    <Window.Resources>
        <viewModel:BooleanToTextConverter x:Key="BoolToText" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,6">
        <!-- Controls row -->
        <DockPanel Grid.Row="0" Margin="12,24,12,0" LastChildFill="False">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton Classes="KeepBackground" x:Name="StartButton" Background="Transparent" IsVisible="True" Checked="StartButton_OnClick" Unchecked="StopButton_OnClick">
                    <heroIcons:HeroIcon Type="Microphone" Height="16" Width="16" Foreground="#7CAFFF" Background="Transparent" Kind="Outline" />
                </ToggleButton>
                <Button x:Name="PauseButton" Background="Transparent" IsVisible="True" Click="PauseButton_OnClick">
                    <heroIcons:HeroIcon Type="Pause" Height="16" Width="16" Foreground="#7CAFFF" Background="Transparent" Kind="Solid" />
                </Button>
                <Button x:Name="StopButton" Background="Transparent" IsVisible="True" Click="StopButton_OnClick">
                    <heroIcons:HeroIcon Type="Stop" Height="16" Width="16" Foreground="#7CAFFF" Background="Transparent" Kind="Outline" />
                </Button>
                <ComboBox x:Name="LanguageComboBox" Width="60" MinHeight="36" IsVisible="True" BorderThickness="0">
                </ComboBox>
                
                <Border ToolTip.Tip="Elapsed time">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="Clock" Foreground="#9ca3af" Width="16" Height="16" Kind="Outline" />
                        <TextBlock x:Name="ElapsedTimeText" Text="00:00" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                </Border>
                <Grid>
                    <Button x:Name="SettingsButton" Background="Transparent" Click="SettingsButton_OnClick" ToolTip.Tip="Settings">
                        <heroIcons:HeroIcon Type="Cog6Tooth" Height="16" Width="16" Foreground="#FFD101" Background="Transparent" Kind="Outline" />
                    </Button>
                    <!-- Green dot indicating an update is ready. Binds to ViewModel bool `UpdateIsReady` -->
                    <Ellipse Width="10" Height="10" Fill="#10b981"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-4,-4,0,0"
                             IsVisible="{Binding UpdateIsReady}" />
                </Grid>
                <Button x:Name="HistoryButton" Background="Transparent" Click="HistoryButton_OnClick" ToolTip.Tip="AI tooltips">
                    <heroIcons:HeroIcon Type="ChatBubbleLeftRight" Height="16" Width="16" Foreground="#FFD101" Kind="Solid" />
                </Button>
                <Button x:Name="SessionHistoryButton" Background="Transparent" Click="SessionHistoryButton_OnClick" ToolTip.Tip="Session History">
                    <heroIcons:HeroIcon Type="Clock" Height="16" Width="16" Foreground="#FFD101" Kind="Outline" />
                </Button>
                <!-- Test confirm dialog button -->
                <!--Button x:Name="TestConfirmButton" Classes="HeaderChip" Height="36" Click="TestConfirmButton_OnClick" ToolTip.Tip="Test confirm dialog">
                    <TextBlock Text="Test Confirm" Foreground="#cbd5e1" FontSize="11"/>
                </Button-->
                <ToggleButton x:Name="PrivacyToggleButton" IsChecked="False" Background="Transparent" Unchecked="PrivacyToggleButton_OnChecked" Checked="PrivacyToggleButton_OnUnchecked" ToolTip.Tip="Toggle Window Privacy">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon x:Name="ProtectedIcon" Height="16" Width="16" IsVisible="True" Type="EyeSlash" Foreground="#FFD101" Kind="Outline" />
                        <heroIcons:HeroIcon x:Name="UnprotectedIcon" Height="16" Width="16" IsVisible="False" Type="Eye" Foreground="#FFD101" Kind="Outline" />
                    </StackPanel>
                </ToggleButton>
                <!-- TODO: In next version I will enable this-->
                <Button x:Name="AddContextButton" Classes="HeaderChip" Height="36" ToolTip.Tip="Add Context" IsVisible="False" Click="AddContextButton_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon Type="PlusCircle" Foreground="#10b981" Width="16" Height="16" Kind="Solid" />
                        <TextBlock Text="Add Ctx (Alt+?)" Foreground="#cbd5e1" FontSize="11"/>
                    </StackPanel>
                </Button>
                <!--ToggleButton x:Name="ToggleButton"
                              Checked="StartButton_OnClick"
                              Unchecked="PauseButton_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <heroIcons:HeroIcon x:Name="StartIcon" IsVisible="True" Type="PlayCircle" Foreground="#7CAFFF" Background="Transparent" Kind="Solid" />
                        <heroIcons:HeroIcon x:Name="PauseIcon" IsVisible="False" Type="PauseCircle" Foreground="#f59e0b" Background="Transparent" Kind="Solid" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="TestButton" Classes="IconButton" Width="40" Height="36" Click="ShowDialog_OnClick">
                    <heroIcons:HeroIcon Type="Cog6Tooth" Foreground="#c52230" Background="Transparent" Kind="Solid" />
                </Button-->
            </StackPanel>
        </DockPanel>
        <UniformGrid Grid.Row="2" x:Name="AiButtonsPanel" Columns="1" VerticalAlignment="Center" IsVisible="True" ScrollViewer.VerticalScrollBarVisibility="Visible" />
        <TextBox Grid.Row="2" x:Name="AiAssistantResponseTextBox" Text="Press WIN+? to get your first tip"
                 Margin="12,0,12,4" IsReadOnly="True"
                 TextWrapping="Wrap" Height="120" MaxHeight="120"
                 IsVisible="False"
                 ScrollViewer.VerticalScrollBarVisibility="Visible" />
    <!-- Placeholder (no logs displayed) -->
    </Grid>
</Window>

