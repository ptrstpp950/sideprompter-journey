<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:AvaloniaApp.ViewModel"
        xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
        x:Class="AvaloniaApp.SessionHistoryWindow"
        x:DataType="viewModel:SessionHistoryViewModel"
        x:CompileBindings="True"
        Width="460" Height="500"
        Title="Session History"
        CanResize="True"
        mc:Ignorable="d">

  <Grid Margin="12" RowDefinitions="Auto,*">
    <!-- Search bar -->
    <TextBox Grid.Row="0"
             x:Name="SearchBox"
             Watermark="Search sessions..."
             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Margin="0,0,0,8" />

    <!-- Session list -->
    <ListBox Grid.Row="1"
             x:Name="SessionListBox"
             ItemsSource="{Binding Sessions}"
             SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
             DoubleTapped="SessionListBox_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="viewModel:SessionListItem">
          <Border Margin="2,4" Padding="10" CornerRadius="8" BorderBrush="#444" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <!-- Title -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{Binding Title}"
                         FontWeight="SemiBold"
                         FontSize="14"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />

              <!-- Action buttons -->
              <StackPanel Grid.Row="0" Grid.Column="1"
                          Orientation="Horizontal" Spacing="2"
                          VerticalAlignment="Center">
                <Button Background="Transparent" Padding="4"
                        ToolTip.Tip="Open session"
                        Click="OpenSession_Click"
                        Tag="{Binding}">
                  <heroIcons:HeroIcon Type="FolderOpen" Height="14" Width="14" Foreground="#9ca3af" Kind="Outline" />
                </Button>
                <Button Background="Transparent" Padding="4"
                        ToolTip.Tip="Rename session"
                        Click="RenameSession_Click"
                        Tag="{Binding}">
                  <heroIcons:HeroIcon Type="Pencil" Height="14" Width="14" Foreground="#9ca3af" Kind="Outline" />
                </Button>
                <Button Background="Transparent" Padding="4"
                        ToolTip.Tip="Delete session"
                        Click="DeleteSession_Click"
                        Tag="{Binding}">
                  <heroIcons:HeroIcon Type="Trash" Height="14" Width="14" Foreground="#ef4444" Kind="Outline" />
                </Button>
              </StackPanel>

              <!-- Subtitle row: date + message count -->
              <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <TextBlock Text="{Binding DateFormatted}"
                           FontSize="11" Foreground="#9ca3af" />
                <TextBlock Text="{Binding Subtitle}"
                           FontSize="11" Foreground="#9ca3af" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>


</Window>
