<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.LanguagesSettingsPageView"
             x:CompileBindings="True">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0" Text="Languages" FontSize="18" FontWeight="Bold"/>

    <StackPanel Grid.Row="1" Spacing="4">
      <TextBlock Text="No languages selected - tap to choose from the list below." FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
      <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="SelectedPanel" />
      </ScrollViewer>
      <TextBlock x:Name="CountsText" FontSize="11" Opacity="0.75"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="Search:" VerticalAlignment="Center"/>
      <TextBox HorizontalAlignment="Stretch" x:Name="SearchBox" Watermark="Type the language"/>
    </StackPanel>

    <ListBox Grid.Row="3" x:Name="AllList" Margin="0,4,0,0"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
      <Button x:Name="AddButton" Content="Add"/>
      <Button x:Name="UndoButton" Content="Undo Last"/>
      <Button x:Name="ClearButton" Content="Clear All"/>
    </StackPanel>

    <TextBlock Grid.Row="5" Text="Tip: English (en) recommended for interface." FontSize="11" FontStyle="Italic" Opacity="0.85"/>
  </Grid>
</UserControl>
