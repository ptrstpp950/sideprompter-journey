<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AvaloniaApp"
             xmlns:settings="clr-namespace:AvaloniaApp.Settings"
             x:Class="AvaloniaApp.PromptsSettingsPageView"
             x:CompileBindings="True"
             x:DataType="local:PromptsSettingsViewModel">
  <ScrollViewer>
    <StackPanel Spacing="10">
      <TextBlock Text="Conversation Prompts" FontSize="18" FontWeight="Bold"/>

      <ItemsControl ItemsSource="{Binding Settings.Prompts}" x:Name="PromptsItems">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="settings:Prompt">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="Move Up" Click="MoveUpButton_Click" Tag="{Binding}"/>
                  <Button Content="Move Down" Click="MoveDownButton_Click" Tag="{Binding}"/>
                  <Button Content="Edit" Click="EditButton_Click" Tag="{Binding}"/>
                  <Button Content="Remove" Click="RemoveButton_Click" Tag="{Binding}" Classes="danger"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5" IsVisible="{Binding SelectedPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <TextBlock Text="Edit Prompt" FontWeight="Bold" FontSize="16"/>
          <TextBlock Text="Title:"/>
          <TextBox Text="{Binding SelectedPrompt.Title}" />
          <TextBlock Text="Prompt Text:"/>
          <TextBox Text="{Binding SelectedPrompt.PromptText}" AcceptsReturn="True" Height="200" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save" Click="SaveButton_Click"/>
            <Button Content="Cancel" Click="CancelButton_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Content="Add New Prompt" Click="AddButton_Click" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>